# Database Configuration
# Note: the current Prisma schema uses a fixed SQLite path and does not read DATABASE_URL.
# Keep this here only for compatibility with older local setups or future migration.
DATABASE_URL="file:./dev.db"

# Backend Network
# Optional. Defaults:
# - development: 0.0.0.0:3001
# - production:  0.0.0.0:3462
HOST=0.0.0.0
PORT=3001

# HuggingFace Configuration
# Optional. Defaults to the public RWKV Chat dataset when empty.
HF_DATASETS_ID="HaloWang/rwkv-chat"
HF_TOKEN=""
HF_ENDPOINT="https://huggingface.co"

# ModelScope Configuration
# Optional. Used for app release downloads and weight-mirror verification.
MODELSCOPE_ENDPOINT="https://modelscope.cn"
MODELSCOPE_REPO_ID="HaloWang1991/rwkv-chat"
MODELSCOPE_REVISION="master"
MODELSCOPE_API_TOKEN=""

# GitHub Configuration
# Optional. GITHUB_REPO has a built-in default.
GITHUB_REPO="RWKV-APP/RWKV_APP"
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# Pgyer Configuration
# Optional. If PGYER_API_KEY is empty, related distribution checks are skipped.
PGYER_API_KEY=""
PGYER_APP_KEY="rwkvchat"

# Admin Authentication
# Strongly recommended in production.
# If left empty in runtime, the backend falls back to insecure development defaults.
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"
ADMIN_TOKEN_SECRET="change-me"
ADMIN_TOKEN_TTL_HOURS=12

# RWKV Lightning Chat Proxy
# Optional. Required only for the admin RWKV Chat page.
# Keep real values in backend/.env.local or production environment variables.
RWKV_LIGHTNING_7B_PASSWORD=""
RWKV_LIGHTNING_13B_PASSWORD=""
RWKV_LIGHTNING_PASSWORD=""
RWKV_CHAT_LIGHTNING_BATCH_SIZE=4

# RWKV Chat Web Search Providers
# Optional. Leave keys empty to show the provider as skipped in /admin/rwkv-chat.
RWKV_CHAT_SEARCH_CONCURRENCY=6
RWKV_CHAT_SEARCH_TIMEOUT_MS=12000
RWKV_APP_WEB_SEARCH_URL="https://auth.rwkvos.com/api/internet_search"
RWKV_APP_WEB_SEARCH_TOKEN=""
RWKV_APP_WEB_SEARCH_TOP_N=3

GEO_PRESALES_QWEN_API_KEY=""
GEO_PRESALES_QWEN_BASE_URL="https://dashscope.aliyuncs.com"
GEO_PRESALES_QWEN_MODEL="qwen-plus"

GEO_PRESALES_KIMI_API_KEY=""
GEO_PRESALES_KIMI_BASE_URL="https://api.moonshot.cn/v1"
GEO_PRESALES_KIMI_MODEL="kimi-k2-0905-preview"

GEO_PRESALES_ZHIPU_API_KEY=""
GEO_PRESALES_ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GEO_PRESALES_ZHIPU_MODEL="glm-4.5"

GEO_PRESALES_STEPFUN_API_KEY=""
GEO_PRESALES_STEPFUN_BASE_URL="https://api.stepfun.com/v1"
GEO_PRESALES_STEPFUN_SEARCH_COUNT=10

GEO_PRESALES_QIANFAN_API_KEY=""
GEO_PRESALES_QIANFAN_BASE_URL="https://qianfan.baidubce.com"
GEO_PRESALES_QIANFAN_WEB_SEARCH_TOP_K=10

GEO_PRESALES_TENCENT_WSA_API_KEY=""
GEO_PRESALES_TENCENT_WSA_API_KEY_BASE_URL="https://wsa.tencentcloudapi.com"
GEO_PRESALES_TENCENT_WSA_SECRET_ID=""
GEO_PRESALES_TENCENT_WSA_SECRET_KEY=""
GEO_PRESALES_TENCENT_WSA_TOKEN=""
GEO_PRESALES_TENCENT_WSA_SIGNED_ENDPOINT="https://wsa.tencentcloudapi.com"

GEO_PRESALES_ARK_API_KEY=""
GEO_PRESALES_ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
GEO_PRESALES_ARK_MODEL="doubao-seed-1-6-251015"

GEO_PRESALES_DEEPSEEK_API_KEY=""
GEO_PRESALES_DEEPSEEK_BASE_URL="https://api.deepseek.com"
GEO_PRESALES_DEEPSEEK_ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
GEO_PRESALES_DEEPSEEK_MODEL="deepseek-chat"

# Telemetry
# Used to hash installId before storing. Change this in production.
TELEMETRY_SALT="change-me"
