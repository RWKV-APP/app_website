# Database Configuration
# Note: the current Prisma schema uses a fixed SQLite path and does not read DATABASE_URL.
# Keep this here only for compatibility with older local setups or future migration.
DATABASE_URL="file:./dev.db"

# Backend Network
# Optional. Defaults:
# - development: 0.0.0.0:3001
# - production:  0.0.0.0:3462
HOST=0.0.0.0
PORT=3001

# HuggingFace Configuration
# Optional. If HF_DATASETS_ID is empty, related distribution checks are skipped.
HF_DATASETS_ID=""
HF_TOKEN=""
HF_ENDPOINT="https://huggingface.co"

# GitHub Configuration
# Optional. GITHUB_REPO has a built-in default.
GITHUB_REPO="RWKV-APP/RWKV_APP"
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# Pgyer Configuration
# Optional. If PGYER_API_KEY is empty, related distribution checks are skipped.
PGYER_API_KEY=""
PGYER_APP_KEY="rwkvchat"

# Admin Authentication
# Strongly recommended in production.
# If left empty in runtime, the backend falls back to insecure development defaults.
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"
ADMIN_TOKEN_SECRET="change-me"
ADMIN_TOKEN_TTL_HOURS=12
