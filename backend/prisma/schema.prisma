// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./rwkv.app.db"
}

// Add your models here

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distribution {
  id        Int      @id @default(autoincrement())
  type      String
  url       String
  version   String
  build     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RemoteConfig {
  id             Int                    @id @default(autoincrement())
  type           String
  fileName       String
  effectiveBuild Int?
  content        String
  published      Boolean                @default(false)
  createdBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  activities     RemoteConfigActivity[]

  @@index([type, fileName, published])
  @@index([type, effectiveBuild, published])
}

model RemoteConfigActivity {
  id             Int           @id @default(autoincrement())
  action         String
  username       String
  fileName       String?
  detail         String?
  remoteConfigId Int?
  createdAt      DateTime      @default(now())
  remoteConfig   RemoteConfig? @relation(fields: [remoteConfigId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([fileName])
  @@index([remoteConfigId])
}

model EvalRun {
  id                        Int          @id @default(autoincrement())
  runId                     String       @unique
  uploadedFileName          String
  uploadedBy                String?
  uploadedAt                DateTime     @default(now())
  runCreatedAt              DateTime?
  runUpdatedAt              DateTime?
  status                    String
  language                  String
  taskType                  String
  baseUrl                   String?
  endpoint                  String
  sourceFile                String
  modelRequest              String?
  modelNameReportedByServer String?
  selectionMode             String?
  sourceTotalItems          Int          @default(0)
  sampleCountRequested      Int          @default(0)
  repeatCount               Int          @default(0)
  maxTokens                 Int?
  seed                      Int?
  totalSamples              Int          @default(0)
  completedSamples          Int          @default(0)
  runningSamples            Int          @default(0)
  partialSamples            Int          @default(0)
  errorSamples              Int          @default(0)
  pendingSamples            Int          @default(0)
  doneAttempts              Int          @default(0)
  totalAttempts             Int          @default(0)
  latestCompletedSampleIndex Int?
  latestCompletedCategory   String?
  evalDeviceLabel           String?
  evalDeviceCpu             String?
  evalDeviceGpu             String?
  evalDeviceMemoryGb        Float?
  evalDeviceVramGb          Float?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  samples                   EvalSample[]

  @@index([uploadedAt])
  @@index([runUpdatedAt])
}

model EvalSample {
  id                       Int                 @id @default(autoincrement())
  evalRunId                Int
  sampleIndex              Int
  status                   String
  renderingName            String
  prompt                   String
  sourceFile               String
  sourceCategory           String
  sourceCategoryDisplayName String
  sourceCategoryIndex      Int
  sourceItemIndex          Int
  baseUrl                  String?
  endpoint                 String
  modelRequest             String?
  modelNameReportedByServer String?
  maxTokens                Int?
  repeatCountTarget        Int                 @default(0)
  repeatCountDone          Int                 @default(0)
  sampleStartedAt          DateTime?
  sampleUpdatedAt          DateTime?
  averageWeightedScore     Float?
  averageRelevance         Float?
  averageQuality           Float?
  averageFluency           Float?
  averageSatisfaction      Float?
  scoredAttemptCount       Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  run                      EvalRun             @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  attempts                 EvalSampleAttempt[]

  @@unique([evalRunId, sampleIndex])
  @@index([sourceCategory])
  @@index([averageWeightedScore])
}

model EvalSampleAttempt {
  id            Int        @id @default(autoincrement())
  evalSampleId  Int
  attempt       Int
  status        String
  startedAt     DateTime?
  endedAt       DateTime?
  durationMs    Int?
  responseChars Int?
  response      String?
  errorType     String?
  errorMessage  String?
  errorBody     String?
  relevance     Int?
  quality       Int?
  fluency       Int?
  satisfaction  Int?
  weightedScore Float?
  briefNote     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sample        EvalSample @relation(fields: [evalSampleId], references: [id], onDelete: Cascade)

  @@unique([evalSampleId, attempt])
  @@index([weightedScore])
}

model TelemetryPerf {
  id             Int      @id @default(autoincrement())
  schemaVersion  Int      @default(1)

  installIdHash  String

  socName        String
  socBrand       String
  os             String
  osVersion      String?
  deviceModel    String?
  cpuName        String?
  gpuName        String?
  totalMemoryMb  Int?
  totalVramMb    Int?

  appVersion     String
  appBuild       String
  buildMode      String   @default("unknown")

  modelName      String
  modelFileName  String
  modelSha256    String
  modelSizeB     Float?
  quantization   String?
  backend        String

  isBatch        Boolean  @default(false)
  batchCount     Int      @default(1)

  prefillSpeed   Float
  decodeSpeed    Float

  clientTimestamp DateTime
  createdAt      DateTime @default(now())

  @@index([modelSha256, socName, backend, isBatch, decodeSpeed])
  @@index([modelSha256, socName, backend, isBatch, prefillSpeed])
  @@index([socName, backend])
  @@index([installIdHash, createdAt])
  @@index([createdAt])
}
