{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
