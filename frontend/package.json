{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "predev": "pnpm --filter @app/contracts build",
    "prebuild": "pnpm --filter @app/contracts build",
    "build": "node ../tools/generate-build-info.mjs && next build",
    "start": "next start",
    "lint": "pnpm lint:check",
    "lint:check": "next lint",
    "lint:fix": "next lint --fix",
    "pretype-check": "pnpm --filter @app/contracts build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@naverpay/device-info": "^1.1.0",
    "jotai": "^2.0.0",
    "monaco-editor": "^0.55.1",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "eslint": "^8.42.0",
    "eslint-config-next": "^14.0.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.3"
  }
}
